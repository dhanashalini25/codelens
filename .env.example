# Copy to .env and edit. Everything has a working default - CodeLens runs
# static analysis with no key at all.

# ---------------------------------------------------------------- LLM ------
# mock      - offline; static analysis only, no model is called (default)
# groq      - free tier, OpenAI-compatible
# openrouter/together/mistral/openai - any OpenAI-compatible endpoint
# gemini    - Google AI Studio free tier
# ollama    - local models, no key
CODELENS_LLM_PROVIDER=mock

# Groq (free tier)
# CODELENS_LLM_PROVIDER=groq
# CODELENS_LLM_BASE_URL=https://api.groq.com/openai/v1
# CODELENS_LLM_MODEL=openai/gpt-oss-120b
# CODELENS_LLM_API_KEY=gsk_...

# Google Gemini (free tier)
# CODELENS_LLM_PROVIDER=gemini
# CODELENS_LLM_MODEL=gemini-2.0-flash
# CODELENS_LLM_API_KEY=...

# ------------------------------------------------------------- REVIEW ------
# Model findings below this confidence are dropped before they reach you.
CODELENS_MIN_CONFIDENCE=0.5

# Prompt budgets, in characters.
CODELENS_MAX_DIFF_CHARS=14000
CODELENS_MAX_CONTEXT_CHARS=6000

# How many related code chunks to pull in as review context.
CODELENS_CONTEXT_K=4

# ------------------------------------------------------------ INDEXING -----
CODELENS_EMBEDDING_BACKEND=auto
CODELENS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CODELENS_EMBEDDING_DIM=2048
CODELENS_MAX_FILE_BYTES=400000
CODELENS_CHUNK_LINES=60
CODELENS_CHUNK_OVERLAP_LINES=10

# ------------------------------------------------------------- STORAGE -----
CODELENS_DATA_DIR=.codelens
